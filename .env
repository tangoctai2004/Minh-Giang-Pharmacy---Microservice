# ─────────────────────────────────────────────────────────
# Root .env — Được docker-compose.yml đọc tự động
# Copy file này thành .env   rồi điền giá trị thực
# ─────────────────────────────────────────────────────────

# JWT — PHẢI đặt giống nhau cho api-gateway và identity-service
JWT_SECRET=23668e27c1340b01c3de8ff3ad40a5a0

# CORS — Các domain frontend được phép gọi API
# Dùng dev local: không cần thay
CORS_ORIGIN=http://localhost:5500,http://localhost:3000

# ─── Email (nodemailer / notification-service) ───────────
# Dùng Gmail App Password (bật 2FA → https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dominh02102004@gmail.com
SMTP_PASS=yjuvpzcwjgrgwmby

# Debug OTP — đặt là true để trả về OTP trong Response API (tiện cho dev/test)
OTP_DEBUG_RESPONSE=false

# Email gửi đi (phải trùng khớp tên miền/địa chỉ của Gmail SMTP để tránh bị đánh dấu thư rác)
EMAIL_FROM="Nhà thuốc Minh Giang <dominh02102004@gmail.com>"

# ─── Zalo OAuth (đăng nhập Zalo) ─────────────────────────────────────────────
